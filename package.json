{
  "name": "mdcsp",
  "version": "0.1.1",
  "description": "Compose Markdown context files from reusable, conditional snippets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peezy-tech/mdcsp.git"
  },
  "homepage": "https://github.com/peezy-tech/mdcsp#readme",
  "bugs": {
    "url": "https://github.com/peezy-tech/mdcsp/issues"
  },
  "keywords": [
    "agents-md",
    "claude-md",
    "markdown",
    "composition",
    "context"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mdcsp": "dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs dist .test-dist",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/clean.mjs .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "verify": "pnpm clean && pnpm check && pnpm test && pnpm build && node scripts/verify-package.mjs && git diff --check",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.1.3",
  "dependencies": {
    "smol-toml": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
